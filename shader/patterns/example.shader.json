        "binding": "source.phase",
        "classification": "preset",
        "storage": "binary32",
        "unit": "turn",
        "domain": { "minimum": 0.0, "maximum": 1.0 },
        "interpolation": { "kind": "SHORTEST_PERIODIC", "period": 1.0 },
        "default": 0.0
      }
    ],
    "path_policies": [
      { "id": "parallel", "kind": "PARALLEL" }
    ],
    "clocks": [
      { "id": "source-clock", "kind": "frame-clock", "settings": { "wrap": 1.0 } }
    ],
    "preparation": [
      { "id": "frame", "kind": "prepare-frame" }
    ],
    "resources": [],
    "serialization": { "schema_version": 1, "fields": ["scale", "phase"] },
    "approximation": [],
    "handoff": { "policy": "reset" }
  },
  "preset_bank": {
