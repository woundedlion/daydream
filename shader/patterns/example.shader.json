      { "from": "fast", "to": "calm", "path_policy": "parallel", "easing": "EASE_IN_OUT_SIN", "duration": 120 }
    ],
    "absent_edge_fallback": {
      "manual": "SNAP",
      "automatic": "REJECT",
      "synchronized": "REJECT",
      "restore": "SNAP",
      "authoring": "SNAP"
    },
    "choreography": {
      "generated_order": ["calm", "fast"],
      "dwell": { "calm": 600, "fast": 600 }
    }
  },
  "study_metadata": {
    "notes": "Example authoring document"
  }
