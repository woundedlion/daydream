    "presets": [
      { "preset_id": "calm", "display_name": "Calm", "values": { "scale": 1.0, "phase": 0.9 } },
      { "preset_id": "fast", "display_name": "Fast", "values": { "scale": 4.0, "phase": 0.1 } }
