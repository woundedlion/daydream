{
  "schema_version": 1,
  "catalog_version": 1,
  "document_id": "example-study",
  "effect_id": null,
  "descriptor": {
    "graph": {
      "nodes": [
        { "label": "camera", "role": "outer_camera", "operator": "pullback.outer_camera.v1" },
        { "label": "surface", "role": "surface_project", "operator": "pullback.surface_project.v1", "policy": { "lens": "identity", "projection": "equirectangular" } },
        { "label": "warp", "role": "planar_warp", "operator": "pullback.planar_warp.v1", "policy": { "outer": "identity" } },
        { "label": "pattern", "role": "source", "operator": "pullback.source.v1", "policy": { "source": "grid" } },
        { "label": "transfer", "role": "material", "operator": "pullback.material.v1", "policy": { "weight": "projection", "transfer": "linear", "coverage": "opaque" } },
        { "label": "palette", "role": "color", "operator": "pullback.color.v1", "policy": { "color": "generated_palette" } }
      ],
      "edges": [
        { "from": "camera", "to": "surface" },
        { "from": "surface", "to": "warp" },
        { "from": "warp", "to": "pattern" },
        { "from": "pattern", "to": "transfer" },
        { "from": "transfer", "to": "palette" }
      ]
    },
    "parameters": [
      {
        "id": "scale",
        "binding": "source.scale",
        "classification": "preset",
        "storage": "binary32",
