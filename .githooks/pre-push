#!/bin/sh
# Mirror of .github/workflows/js-unit-suite.yml, run before every push.
#
# js-tests.yml fires on pull_request only, and daydream lands directly on
# master, so without this hook the first CI run of the suite is deploy.yml's
# gate — after the push, with a broken master already public.
#
# Installed by package.json's `prepare` script (git config core.hooksPath
# .githooks), so `npm install`/`npm ci` enables it. Skip a single push with
# `git push --no-verify`.
# WASM provenance needs no dependencies, so it gates the push even where the
# suite below cannot run. deploy.yml re-checks it, but only after master is
# public — an unverifiable artifact must not get that far.
# DAYDREAM_WASM_CLEAN_REQUIRED additionally demands that the installed artifacts
# equal their committed blobs. That is false for most of an engine-integration
# session — build, install here, test, then commit — so it is declared at the
# push, where the tested module and the pushed one must finally be the same.
if command -v node >/dev/null 2>&1; then
	DAYDREAM_WASM_CLEAN_REQUIRED=1 node --test tests/wasm_provenance.test.js || exit 1
else
	echo "pre-push: node not found; WASM provenance was not verified." >&2
fi

if ! command -v npm >/dev/null 2>&1; then
	echo "pre-push: npm not found; the JS unit suite did not run." >&2
	exit 0
fi

# Linked worktrees deliberately carry no node_modules of their own, so the suite
# is unrunnable there; warn rather than block a push the main tree can gate.
# npm writes .package-lock.json on install, so it marks a populated tree where an
# empty-but-present directory would pass a bare -d test.
if [ ! -f node_modules/.package-lock.json ]; then
	echo "pre-push: node_modules is missing; the JS unit suite did not run. Run \`npm ci\` to enable it." >&2
	exit 0
fi

npm run lint || exit 1
npm run typecheck || exit 1

# The workflow diffs the whole tree; a developer's is not clean, so scope it.
# Generate to a temp file: regenerating in place would clobber a deliberate
# local-vendoring block in the working tree.
tmp=$(mktemp ./vendor-importmap.XXXXXX) || exit 1
if ! npm run importmap -- --out "$tmp"; then
	rm -f "$tmp"
	exit 1
fi
if ! git show :vendor-importmap.js | git -c core.autocrlf=false diff --no-index --ignore-cr-at-eol --exit-code -- - "$tmp"; then
	rm -f "$tmp"
	echo "pre-push: vendor-importmap.js was stale; regenerate it with \`npm run importmap\`, then commit it and push again." >&2
	exit 1
fi
rm -f "$tmp"

npm test
