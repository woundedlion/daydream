#!/bin/sh
# Source checks are local; CI tests the resolved daydream/engine pair.

for name in $(git rev-parse --local-env-vars); do
	unset "$name"
done

if ! command -v node >/dev/null 2>&1; then
	echo "pre-push: node not found; install Node.js to run the required suites." >&2
	exit 1
fi

if ! command -v npm >/dev/null 2>&1; then
	echo "pre-push: npm not found; install Node.js to run the required suites." >&2
	exit 1
fi
if [ ! -f node_modules/.package-lock.json ]; then
	echo "pre-push: node_modules is missing. Run npm ci in this worktree." >&2
	exit 1
fi

if [ "${DAYDREAM_PUSH_SNAPSHOT:-0}" != 1 ]; then
  checked=0
  while read -r local_ref local_oid remote_ref remote_oid; do
    [ -n "$local_ref$remote_ref$remote_oid" ] || continue
    checked=1
    [ "$local_oid" = 0000000000000000000000000000000000000000 ] && continue
    source_root=$(git rev-parse --show-toplevel) || exit 1
    scratch=$(mktemp -d) || exit 1
    cleanup() {
      node -e 'const fs = require("node:fs"); const p = process.argv[1]; if (fs.existsSync(p) && fs.lstatSync(p).isSymbolicLink()) fs.unlinkSync(p);' "$scratch/repo/node_modules" || return 1
      rm -rf "$scratch"
    }
    trap cleanup EXIT
    git clone --quiet --shared --no-checkout "$source_root" "$scratch/repo" || exit 1
    git -C "$scratch/repo" -c core.hooksPath=/dev/null checkout --quiet --detach "$local_oid" || exit 1
    (
      cd "$scratch/repo" || exit 1
      if git -C "$source_root" diff --quiet "$local_oid" -- package.json package-lock.json; then
        node -e 'require("node:fs").symlinkSync(process.argv[1], "node_modules", process.platform === "win32" ? "junction" : "dir")' "$source_root/node_modules" || exit 1
      else
        npm ci --ignore-scripts || exit 1
      fi
      DAYDREAM_PUSH_SNAPSHOT=1 sh "$source_root/.githooks/pre-push" </dev/null
    ) || exit 1
    cleanup || exit 1
    trap - EXIT
  done
  [ "$checked" = 0 ] || exit 0
fi

npm run lint || exit 1
npm run typecheck || exit 1

tmp=$(mktemp ./vendor-importmap.XXXXXX) || exit 1
trap 'rm -f "$tmp"' EXIT
trap 'exit 130' INT TERM
npm run importmap -- --out "$tmp" || exit 1
# The suites above all run over the working tree, so the freshness check
# compares the file they loaded rather than the staged copy.
if ! git -c core.autocrlf=false diff --no-index --ignore-cr-at-eol --exit-code -- vendor-importmap.js "$tmp"; then
	echo "pre-push: vendor-importmap.js is stale; regenerate and commit it." >&2
	exit 1
fi
rm -f "$tmp"

node --test tests/ci_workflow.test.js tests/deployment_pair.test.js tests/stage_site.test.js || exit 1
