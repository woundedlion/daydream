#!/bin/sh
# Local counterpart of the required JavaScript and browser CI suites.

if command -v node >/dev/null 2>&1; then
	DAYDREAM_WASM_CLEAN_REQUIRED=1 node --test tests/wasm_provenance.test.js || exit 1
else
	echo "pre-push: node not found; WASM provenance was not verified." >&2
fi

if ! command -v npm >/dev/null 2>&1; then
	echo "pre-push: npm not found; the JS unit suite did not run." >&2
	exit 0
fi
if [ ! -f node_modules/.package-lock.json ]; then
	echo "pre-push: node_modules is missing. Run npm ci in this worktree." >&2
	exit 1
fi

npm run lint || exit 1
npm run typecheck || exit 1

tmp=$(mktemp ./vendor-importmap.XXXXXX) || exit 1
trap 'rm -f "$tmp"' EXIT
trap 'exit 130' INT TERM
npm run importmap -- --out "$tmp" || exit 1
if ! git show :vendor-importmap.js | git -c core.autocrlf=false diff --no-index --ignore-cr-at-eol --exit-code -- - "$tmp"; then
	echo "pre-push: vendor-importmap.js is stale; regenerate and commit it." >&2
	exit 1
fi
rm -f "$tmp"

npm test || exit 1

if ! node -e 'import("./scripts/browser.mjs").then((m) => m.resolveBrowser())' 2>/dev/null; then
	echo "pre-push: no browser found; browser probes did not run." >&2
	exit 0
fi
node scripts/browser-smoke.mjs || exit 1
node scripts/workbench-probe.mjs || exit 1
node scripts/panel-probe.mjs || exit 1
node scripts/solids-probe.mjs || exit 1
node scripts/palettes-probe.mjs || exit 1
node scripts/mobius-probe.mjs || exit 1
