#!/bin/sh
# Refuse any non-fast-forward move or deletion of refs/heads/master so
# concurrent code-review-fix sessions cannot clobber each other's landed work.
#
# The fast-forward check derives the ref's current value itself (git update-ref
# reports a zero old-OID to this hook, so the stdin old field cannot be trusted).
#
# A rewind or a deletion needs a deliberate, one-shot, target-scoped token; a
# leaked or global env var can no longer bless routine landings. Authorize the
# exact target, then perform the change:
#   git rev-parse <target> > "$(git rev-parse --git-common-dir)/hs-allow-nonff"
# The target is the new commit for a rewind and the doomed commit for a
# deletion. The token authorizes only that one value and is consumed on use.
# Write the literal ANY instead of a SHA for a blind override. Every refusal and
# every override is appended to <git-common-dir>/hs-nonff.log.
[ "$1" = "prepared" ] || exit 0

z='0000000000000000000000000000000000000000'
gitdir=$(git rev-parse --git-common-dir 2>/dev/null) || gitdir=.git
tokfile="$gitdir/hs-allow-nonff"
logfile="$gitdir/hs-nonff.log"

while read -r _old new ref; do
	[ "$ref" = "refs/heads/master" ] || continue
	cur=$(git rev-parse --verify -q "$ref" 2>/dev/null) || cur=''
	[ -z "$cur" ] && continue                                # creation
	case "$new" in
		"$z"|"") kind='deletion'; target=$cur ;;
		*)
			git merge-base --is-ancestor "$cur" "$new" 2>/dev/null && continue
			kind='rewind'; target=$new ;;
	esac

	ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)
	tok=''
	[ -f "$tokfile" ] && tok=$(tr -d ' \t\r\n' < "$tokfile")
	granted=0
	case "$tok" in
		ANY) granted=1 ;;
		???????*) case "$target" in "$tok"*) granted=1 ;; esac ;;
	esac

	if [ "$granted" = 1 ]; then
		rm -f "$tokfile"
		echo "$ts OVERRIDE $kind master $cur -> $new (token=$tok)" >> "$logfile"
		continue
	fi

	echo "$ts REFUSED $kind master $cur -> $new" >> "$logfile"
	if [ "$kind" = 'deletion' ]; then
		echo "reference-transaction: REFUSED deletion of master (at $cur)." >&2
	else
		echo "reference-transaction: REFUSED non-fast-forward update of master ($cur -> $new)." >&2
	fi
	echo "  Authorize this exact change, then retry (one-shot):" >&2
	echo "    git rev-parse $target > \"$tokfile\"" >&2
	echo "  Write ANY into that file for a blind override. Routine landings cannot override." >&2
	exit 1
done
exit 0
