# The deploy gate reads these on a Linux runner; CRLF would make sha256sum -c
# look for a filename with a trailing CR and break provenance verification.
holosphere_wasm.sha        text eol=lf
holosphere_wasm.js         text eol=lf
holosphere_wasm.wasm.sha256 text eol=lf
holosphere_wasm.toolchain  text eol=lf
*.yml                      text eol=lf
holosphere_wasm.wasm       binary

# The segment-map golden is diffed against the engine checkout's copy on the same
# runner, so its bytes must match the engine's LF-pinned file exactly.
pov_segment_map.json       text eol=lf

# The deploy staging shell reads this line by line; a trailing CR would make
# every path miss on the runner.
site_manifest.txt          text eol=lf

# The deploy gate byte-compares these against the engine checkout's copies on
# the same runner, so their bytes must match the engine's pinned files exactly.
README.md                  text eol=lf
docs/screenshots/**        binary

# Git hooks are sourced by /bin/sh; CRLF would break the shebang on checkout.
.githooks/**               text eol=lf

# The v2 pattern documents and the digest-migration table are pinned
# byte-identical to the compiler's canonical export, which emits LF; the
# catalog joins them so the engine-emitted replacement diffs cleanly.
shader/engine_catalog.json text eol=lf
shader/patterns/**         text eol=lf
