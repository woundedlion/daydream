# npm dependencies — restored with `npm install`, never committed.
# Match at any depth so a stray install under tests/ is never committed.
node_modules/

# Vendored third-party libraries served directly by the page. These are large
# and reproducible; keeping them out of the repo avoids accidental vendoring
# commits and a bloated GitHub Pages artifact. (package-lock.json IS committed
# so the dependency set stays pinned.)
/three.js/
/vendor/

# The Holosphere checkout CI drops here for the engine-parity cases.
/engine/
/engine-bundle/

# Local engine build outputs installed from Holosphere.
/holosphere_wasm.js
/holosphere_wasm.wasm
/holosphere_wasm.sha
/holosphere_wasm.wasm.sha256
/holosphere_wasm.toolchain
/shader/engine_catalog.json

# Linked git worktrees. A checkout of this same tree, so `git add -A` from the
# root would otherwise commit a second copy of the repository.
/.worktrees/

# Local agent tooling and machine-local prompts.
/.claude/
/prompts/

# Editor / IDE
/.vs/
/.idea/
*.swp
*~

# OS cruft
.DS_Store
Thumbs.db

# Scratch copy the pre-push hook regenerates the import map into.
/vendor-importmap.??????

# Logs
*.log

# Recoverable scratch files from interrupted engine installs.
/.hs-tmp-*/
