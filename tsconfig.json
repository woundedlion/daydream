{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "noResolve": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    // The protocol union is carried by a 260-line switch on each side of the
    // postMessage boundary, half of whose message fields are optional: a missed
    // return, a fallen-through case, and a present-but-undefined field are all
    // shapes only these three reject.
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "skipLibCheck": true,
    "types": []
  },
  // The segment/worker pipeline, whose message shapes must agree across the
  // postMessage boundary with no runtime to catch a mismatch, plus every other
  // module that checks clean under the options above and whatever opts in with a
  // `// @ts-check` pragma. A module is absent because it does not yet check
  // clean, not because checking it would be unwelcome; tests/ is out of scope.
  // `noResolve` also means imports are not followed even for the files below, so
  // an unlisted one degrades to `any` with no diagnostic — tests/tsconfig_roster
  // .test.js keeps this list closed under the rostered modules' own imports.
  // holosphere_wasm.d.ts and app_lifecycle.d.ts stand in for modules that are
  // never checked; listing them is what makes those imports resolve under
  // noResolve.
  // tools/ is rostered whole except for the modules that import three, which
  // ships no typings: under noResolve a bare specifier resolves to nothing this
  // program contains, so `@types/three` could not be reached even if installed.
  // tsconfig_roster.test.js holds tools/ to that one exemption. The same puts
  // geometry.js and everything else reached through driver.js out of range, and
  // bootstrap.js with them: its dynamic import of daydream.js is an edge the
  // closure follows.
  "files": [
    "holosphere_wasm.d.ts",
    "app_lifecycle.d.ts",
    "engine_host.js",
    "frame_constants.js",
    "global_stats_view.js",
    "param_sync.js",
    "pixel_view.js",
    "sidebar_logic.js",
    "worker_protocol.js",
    "segment_controller.js",
    "segment_layout.js",
    "segment_stats_view.js",
    "segment_worker.js",
    "tools/banner.js",
    "tools/clipboard.js",
    "tools/color.js",
    "tools/copy_text.js",
    "tools/cpp_format.js",
    "tools/export_params.js",
    "tools/flyout.js",
    "tools/kb_format.js",
    "tools/mobius_transforms.js",
    "tools/page_lifecycle.js",
    "tools/palette_canvas.js",
    "tools/palette_controls.js",
    "tools/palette_math.js",
    "tools/pointer_drag.js",
    "tools/shader_workbench_nav.js",
    "tools/shader_documents.js",
    "tools/slider.js",
    "tools/solid_codegen.js",
    "tools/solid_op_rows.js",
    "tools/solid_registry_codegen.js",
    "tools/solid_render.js"
  ]
}
