{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "noResolve": true,
    "strict": false,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "skipLibCheck": true,
    "types": []
  },
  // Deliberately narrow: only the segment/worker pipeline, whose message shapes
  // must agree across the postMessage boundary with no runtime to catch a
  // mismatch. The rest of the app and every tests/ file are out of scope.
  // `noResolve` also means imports are not followed even for the files below, so
  // an unlisted one degrades to `any` with no diagnostic — tests/tsconfig_roster
  // .test.js keeps this list closed under the pipeline's own imports.
  "files": [
    "frame_constants.js",
    "worker_protocol.js",
    "segment_controller.js",
    "segment_layout.js",
    "segment_stats_view.js",
    "segment_worker.js"
  ]
}
