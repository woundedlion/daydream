{
  "name": "daydream",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "pretest": "node scripts/require-tests.mjs",
    "test": "node scripts/run-tests.mjs --experimental-test-module-mocks \"tests/**/*.test.js\" \"tests/**/*.test.mjs\" \"tests/**/*.spec.js\" \"tests/**/*.spec.mjs\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "importmap": "node scripts/generate-importmap.mjs",
    "importmap:local": "node scripts/generate-importmap.mjs --local",
    "generate:tailwind": "tailwindcss --input styles/tailwind.input.css --content \"./tools/*.html,./src/**/*.js\" --output tools/tailwind.css --minify"
  },
  "dependencies": {
    "lil-gui": "0.21.0",
    "three": "0.183.1"
  },
  "engines": {
    "node": "22.23.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@puppeteer/browsers": "3.2.0",
    "eslint": "10.8.0",
    "espree": "11.2.0",
    "globals": "17.9.0",
    "puppeteer-core": "25.7.0",
    "tailwindcss": "3.4.17",
    "typescript": "7.0.2"
  }
}
